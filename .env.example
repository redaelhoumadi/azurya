# URL publique du site (SEO, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.azuryarh.fr

# Formulaire de contact : adresse qui reçoit les demandes
CONTACT_TO_EMAIL=contact@azuryarh.fr
# Expéditeur, sur un domaine vérifié chez le fournisseur d'envoi
CONTACT_FROM_EMAIL="azurya <site@azuryarh.fr>"

# Resend (https://resend.com) — laisser vide tant que le compte n'est pas créé :
# le formulaire indiquera alors que l'envoi en ligne n'est pas activé.
RESEND_API_KEY=
